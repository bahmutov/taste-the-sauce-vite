{
  "compilerOptions": {
    "moduleResolution": "node",
    "types": [
      "cypress",
      "cypress-map",
      "cypress-plugin-steps",
      "vite/client",
      "vite-plugin-svgr/client"
    ],
    "target": "es2022",
    "lib": ["es2019", "dom"],
    "strict": true,
    "noImplicitAny": true,
    "allowJs": true,
    "noEmit": true,
    "skipLibCheck": true,
    "resolveJsonModule": true,
    "allowSyntheticDefaultImports": true,
    "baseUrl": "src",
    "paths": {
      "@support/*": ["../cypress/support/*"],
      "@fixtures/*": ["../cypress/fixtures/*"]
    }
  },
  "include": [
    "cypress/support/component.jsx",
    "cypress/support/**/*.ts",
    "cypress/e2e/**/*.js",
    "cypress/e2e/**/*.ts",
    "src/**/*.cy.js",
    "src/**/*.cy.jsx"
  ],
  "exclude": ["coverage", "node_modules"]
}
