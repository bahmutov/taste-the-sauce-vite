{
  "name": "taste-the-sauce-vite",
  "description": "Cypress testing tutorial using the SauceLabs sample web app",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "dependencies": {
    "@fortawesome/fontawesome-svg-core": "^6.7.2",
    "@fortawesome/free-solid-svg-icons": "^6.7.2",
    "@fortawesome/react-fontawesome": "3.1.1",
    "@types/react-router-dom": "^5.3.3",
    "js-cookie": "^2.2.1",
    "react": "^19.2.3",
    "react-app-polyfill": "^2.0.0",
    "react-burger-menu": "^3.1.0",
    "react-dom": "^19.2.3",
    "react-router-dom": "^6.28.1",
    "vite-plugin-istanbul": "7.2.1",
    "web-vitals": "^1.1.1"
  },
  "devDependencies": {
    "@bahmutov/cypress-code-coverage": "^2.5.1",
    "@types/react": "^19.2.7",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^5.1.2",
    "chai-sorted": "^0.2.0",
    "check-code-coverage": "^1.10.4",
    "cypress": "^15.8.1",
    "cypress-data-session": "^2.8.2",
    "cypress-map": "^1.56.0",
    "cypress-on-fix": "^1.0.0",
    "cypress-real-events": "^1.15.0",
    "cypress-split": "^1.24.13",
    "cypress-watch-and-reload": "^1.10.6",
    "find-cypress-specs": "1.54.8",
    "prettier": "^3.2.5",
    "prop-types": "^15.7.2",
    "start-server-and-test": "^2.0.0",
    "stop-only": "^3.3.1",
    "typescript": "^5.6.3",
    "vite": "^6.4.1",
    "vite-plugin-svgr": "^4.5.0"
  },
  "scripts": {
    "start": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "test": "cypress run",
    "cy:open": "cypress open --e2e",
    "cy:component": "cypress open --component --browser electron",
    "run:component": "cypress run --component",
    "dev": "start-test 3000 cy:open",
    "ci": "start-test 3000",
    "lint": "tsc --noEmit --pretty",
    "clean": "rm -rf .nyc_output coverage",
    "cc-badge": "update-badge",
    "only": "stop-only --folder cypress/e2e --folder src",
    "only:warn": "stop-only --warn --folder cypress/e2e --folder src",
    "names": "find-cypress-specs --names",
    "names:component": "find-cypress-specs --names --component",
    "badge:tests": "find-cypress-specs --test-counts --update-badge"
  },
  "browserslist": {
    "production": [
      ">0.2%",
      "not dead",
      "not op_mini all",
      "ie 11"
    ],
    "development": [
      "last 1 chrome version",
      "last 1 firefox version",
      "last 1 safari version",
      "ie 11"
    ]
  },
  "nyc": {
    "all": true,
    "include": [
      "src/**/*.js",
      "src/**/*.jsx"
    ],
    "exclude": [
      "src/**/*.cy.js",
      "src/**/*.cy.jsx",
      "src/service*.js"
    ]
  }
}
